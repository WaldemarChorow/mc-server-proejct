# Minecraft Server Environment Variables
# Copy this file to .env and adjust the values for your host.

# Network
MC_PORT=8888

# Java heap size. Keep well below the host's total RAM — the JVM needs
# memory beyond the heap, and so does the operating system.
MC_MEMORY_MIN=1G
MC_MEMORY_MAX=2G

# Server properties (applied on first start only)
MC_MOTD=A Minecraft Server
MC_DIFFICULTY=easy
MC_GAMEMODE=survival
MC_MAX_PLAYERS=20
MC_ONLINE_MODE=true
MC_PVP=true
MC_VIEW_DISTANCE=10
MC_LEVEL_NAME=world
